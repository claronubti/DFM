{
  "info": {
    "_postman_id": "9d42c710-8b1e-45a7-9654-watchdog-collection",
    "name": "Azure Watchdog Function & Fabric APIs",
    "description": "Complete Postman collection for testing the 24/7 Autonomous Watchdog Azure Function (FastAPI) and the underlying Microsoft Fabric REST APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Azure Function Watchdog Endpoints",
      "description": "FastAPI endpoints exposed by the Azure Function appliance.",
      "item": [
        {
          "name": "Health Check & Fabric Auth Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            },
            "description": "Returns watchdog health, verifies Microsoft Fabric Service Principal token validity, and reports status."
          },
          "response": []
        },
        {
          "name": "List Capacity-Assigned Workspaces",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/workspaces/capacity",
              "host": ["{{base_url}}"],
              "path": ["api", "workspaces", "capacity"]
            },
            "description": "Sweeps the tenant and returns only workspaces assigned to a dedicated Fabric capacity (~30 workspaces)."
          },
          "response": []
        },
        {
          "name": "Trigger 24/7 Autonomous Sweep (On-Demand)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/sweep/trigger",
              "host": ["{{base_url}}"],
              "path": ["api", "sweep", "trigger"]
            },
            "description": "Executes on-demand autonomous 24/7 watchdog sweep ONLY for pipelines configured with L1/L2 in the sla_configs table. Checks latest Fabric execution runs, evaluates active SLA deadlines, and dispatches multi-tier alert emails (L1 failure, L2 escalation, critical SLA2 breaches, and auto-recoveries)."
          },
          "response": []
        },
        {
          "name": "Get Active & Escalated Incidents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/incidents/active",
              "host": ["{{base_url}}"],
              "path": ["api", "incidents", "active"]
            },
            "description": "Retrieves all unresolved SLA incidents from the shared database."
          },
          "response": []
        },
        {
          "name": "Send Test Verification Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_recipient_email}}\",\n  \"role\": \"L1 Support Lead\",\n  \"pipelineName\": \"Telemetry Verification Pipeline\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/test-email",
              "host": ["{{base_url}}"],
              "path": ["api", "test-email"]
            },
            "description": "Sends a verification test email over SMTP to verify alert deliverability."
          },
          "response": []
        },
        {
          "name": "OpenAPI Specification (JSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/openapi.json",
              "host": ["{{base_url}}"],
              "path": ["openapi.json"]
            },
            "description": "Returns raw OpenAPI 3.0 specification generated by FastAPI."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Underlying Microsoft Fabric REST APIs",
      "description": "Step-by-step raw Fabric APIs used by the Azure Function to monitor pipelines and extract telemetry.",
      "item": [
        {
          "name": "Step 1: Acquire Fabric OAuth2 Token (Service Principal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set(\"fabric_token\", jsonData.access_token);",
                  "    pm.test(\"Token acquired and saved to environment\", function () {",
                  "        pm.expect(jsonData.access_token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "https://api.fabric.microsoft.com/.default",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "https://login.microsoftonline.com/{{tenant_id}}/oauth2/v2.0/token",
              "protocol": "https",
              "host": ["login", "microsoftonline", "com"],
              "path": ["{{tenant_id}}", "oauth2", "v2.0", "token"]
            },
            "description": "Acquires an Azure Entra ID OAuth2 bearer token for Microsoft Fabric REST APIs."
          },
          "response": []
        },
        {
          "name": "Step 2: List Workspaces (Inspect Capacity IDs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.value && jsonData.value.length > 0) {",
                  "    var capacityWorkspaces = jsonData.value.filter(function(ws) {",
                  "        return ws.capacityId && ws.capacityId !== '00000000-0000-0000-0000-000000000000';",
                  "    });",
                  "    console.log('Discovered ' + capacityWorkspaces.length + ' capacity workspaces.');",
                  "    if (capacityWorkspaces.length > 0) {",
                  "        pm.environment.set(\"workspace_id\", capacityWorkspaces[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{fabric_token}}"
              }
            ],
            "url": {
              "raw": "{{fabric_base_url}}/workspaces",
              "host": ["{{fabric_base_url}}"],
              "path": ["workspaces"]
            },
            "description": "Lists all workspaces in the tenant. Filter for capacityId to target capacity-assigned workspaces."
          },
          "response": []
        },
        {
          "name": "Step 3: List Data Pipelines in Workspace",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.value && jsonData.value.length > 0) {",
                  "    pm.environment.set(\"pipeline_id\", jsonData.value[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{fabric_token}}"
              }
            ],
            "url": {
              "raw": "{{fabric_base_url}}/workspaces/{{workspace_id}}/items?type=DataPipeline",
              "host": ["{{fabric_base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "items"],
              "query": [
                {
                  "key": "type",
                  "value": "DataPipeline"
                }
              ]
            },
            "description": "Lists all data pipeline items in a selected workspace."
          },
          "response": []
        },
        {
          "name": "Step 4: Get Pipeline Execution Runs (Job Instances)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.value && jsonData.value.length > 0) {",
                  "    pm.environment.set(\"run_id\", jsonData.value[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{fabric_token}}"
              }
            ],
            "url": {
              "raw": "{{fabric_base_url}}/workspaces/{{workspace_id}}/items/{{pipeline_id}}/jobs/instances",
              "host": ["{{fabric_base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "items", "{{pipeline_id}}", "jobs", "instances"]
            },
            "description": "Fetches recent job instance execution runs for a pipeline to inspect status."
          },
          "response": []
        },
        {
          "name": "Step 5: Query Activity Runs & Error Diagnostics",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{fabric_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lastUpdatedAfter\": \"2026-10-01T00:00:00Z\",\n  \"lastUpdatedBefore\": \"2026-10-08T23:59:59Z\",\n  \"filters\": [],\n  \"orderBy\": [\n    {\n      \"orderBy\": \"ActivityRunStart\",\n      \"order\": \"DESC\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{fabric_base_url}}/workspaces/{{workspace_id}}/datapipelines/pipelineruns/{{run_id}}/queryactivityruns",
              "host": ["{{fabric_base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "datapipelines", "pipelineruns", "{{run_id}}", "queryactivityruns"]
            },
            "description": "Queries granular inner activity runs and failure diagnostics for a failed pipeline run."
          },
          "response": []
        }
      ]
    }
  ]
}
